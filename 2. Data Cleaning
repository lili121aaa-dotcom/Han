def generate_visualizations(df, target_col=None, output_dir=None):
    """Generate and save visualizations for key numeric features"""
    if output_dir is None:
        output_dir = "/content/drive/My Drive/2 auto results/Step5_Visualizations"
    os.makedirs(output_dir, exist_ok=True)

    results_file = os.path.join(output_dir, "Step5_Visualization_Statistics.txt")
    results = open(results_file, 'w', encoding='utf-8')
    results.write("="*80 + "\n")
    results.write("Step 5: Visualization Report\n")
    results.write(f"Generated on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
    results.write("="*80 + "\n\n")

    numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
    if target_col and target_col in numeric_cols:
        numeric_cols = [col for col in numeric_cols if col != target_col]

    print(f"Found {len(numeric_cols)} numeric features")
    results.write(f"Found {len(numeric_cols)} numeric features\n")
    results.write(f"List: {numeric_cols}\n\n")

    if not numeric_cols:
        print("No numeric features to visualize")
        results.close()
        return

    cols_to_plot = numeric_cols[:3]
    print(f"Generating charts for: {cols_to_plot}")
    results.write(f"Selected features: {cols_to_plot}\n\n")

    successful = []
    for i, col in enumerate(cols_to_plot):
        if col not in df.columns or df[col].nunique() <= 1:
            continue
        try:
            plt.figure(figsize=(12, 5))
            # Boxplot
            plt.subplot(1, 3, 1)
            sns.boxplot(y=df[col])
            plt.title(f"{col} - Box Plot")
            plt.ylabel(col)

            # Histogram
            plt.subplot(1, 3, 2)
            plt.hist(df[col].dropna(), bins=30, alpha=0.7, edgecolor='black')
            plt.title(f"{col} - Distribution")
            plt.xlabel(col)
            plt.ylabel("Frequency")

            # Stats text
            stats_text = f"""Basic Statistics
Count: {df[col].count()}
Mean: {df[col].mean():.2f}
Median: {df[col].median():.2f}
Std Dev: {df[col].std():.2f}
Min: {df[col].min():.2f}
Max: {df[col].max():.2f}
Missing: {df[col].isnull().sum()}"""
            plt.subplot(1, 3, 3)
            plt.text(0.1, 0.5, stats_text, transform=plt.gca().transAxes, fontsize=10,
                     verticalalignment='center', bbox=dict(boxstyle='round', facecolor='lightgray'))
            plt.axis('off')
            plt.title(f"{col} - Statistics")

            plt.tight_layout()
            filename = f"5_{i+1}_{col}_visualization.png"
            path = os.path.join(output_dir, filename)
            plt.savefig(path, dpi=300, bbox_inches='tight')
            plt.show()

            results.write(f"[{col}] Statistics:\n")
            results.write(f"  Count: {df[col].count()}\n")
            results.write(f"  Mean: {df[col].mean():.4f}\n")
            results.write(f"  Median: {df[col].median():.4f}\n")
            results.write(f"  Std Dev: {df[col].std():.4f}\n")
            results.write(f"  Min: {df[col].min():.4f}\n")
            results.write(f"  Max: {df[col].max():.4f}\n")
            results.write(f"  Missing: {df[col].isnull().sum()}\n")
            results.write(f"  Chart saved: {filename}\n\n")
            successful.append(col)
