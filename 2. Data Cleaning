def detect_redundant_variables(df, corr_threshold=0.9, target_col=None):
    """Detect and remove highly correlated redundant features"""
    before_cols = set(df.columns)
    num_cols = df.select_dtypes(include=[np.number]).columns
    redundant_pairs = []
    redundant_cols = []

    if len(num_cols) > 1:
        corr_matrix = df[num_cols].corr().abs()
        upper_triangle = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))

        for row in upper_triangle.index:
            for col in upper_triangle.columns:
                val = upper_triangle.loc[row, col]
                if not pd.isnull(val) and val > corr_threshold:
                    redundant_pairs.append((row, col, round(val, 3)))

        for pair in redundant_pairs:
            col_to_drop = pair[1]
            if col_to_drop != target_col and col_to_drop not in redundant_cols:
                redundant_cols.append(col_to_drop)

        df_cleaned = df.drop(columns=[c for c in redundant_cols if c in df.columns]) if redundant_cols else df.copy()
        after_cols = set(df_cleaned.columns)

        print(f"Features before redundancy check: {len(before_cols)}")
        print(f"Features after redundancy check: {len(after_cols)}")
        print(f"Removed redundant features ({len(redundant_cols)}): {redundant_cols}")
        print(f"Number of high-correlation pairs found: {len(redundant_pairs)}")

        if redundant_pairs:
            redundant_df = pd.DataFrame(redundant_pairs, columns=["Feature A", "Feature B", "Correlation"])
            redundant_df["Suggested Removal"] = redundant_df["Feature B"]
            print("\nTop 10 redundant pairs:")
            print(redundant_df.head(10))

            output_path = "/content/drive/My Drive/2 auto results/Redundant_Variables_Report.xlsx"
            redundant_df.to_excel(output_path, index=False)
            print(f"\nRedundant variable report saved to: {output_path}")
        else:
            print("No highly correlated pairs found")
    else:
        print("Not enough numeric columns. Skipping redundancy detection.")
        df_cleaned = df.copy()
        redundant_cols = []

    return df_cleaned, redundant_cols

