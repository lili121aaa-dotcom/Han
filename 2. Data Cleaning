def remove_useless_columns(df, target_col=None):
    """Remove columns with no predictive value"""
    before_cols = set(df.columns)

    # (1) Columns with only one unique value
    useless_cols = df.nunique()[df.nunique() == 1].index.tolist()

    # (2) Business-irrelevant columns (IDs, addresses, etc.)
    potential_drop_cols = [
       "city", "county", "latitude", "longitude", "individual_id",
        "address_id", "date_of_birth"
    ]

    # Keep only existing columns
    to_drop = [col for col in (useless_cols + potential_drop_cols) if col in df.columns]

    # Never drop target column
    if target_col and target_col in to_drop:
        to_drop.remove(target_col)

    # Perform drop
    df_cleaned = df.drop(columns=to_drop) if to_drop else df.copy()
    after_cols = set(df_cleaned.columns)

    print(f"Features before removal: {len(before_cols)}")
    print(f"Features after removal: {len(after_cols)}")
    print(f"Removed features ({len(to_drop)}): {to_drop}")
    print(f"Retained features: {len(after_cols)}")

    return df_cleaned, to_drop

