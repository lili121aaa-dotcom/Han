def analyze_missing_pattern(df, target_col=None):
    """Analyze missing value patterns"""
    print("--- Missing Value Pattern Analysis ---")
    total_rows = df.shape[0]
    total_cols = df.shape[1]
    missing_by_col = df.isnull().sum()
    missing_ratio_by_col = (missing_by_col / total_rows * 100).round(2)
    missing_by_row = df.isnull().sum(axis=1)
    rows_with_missing = (missing_by_row > 0).sum()
    missing_ratio_by_row = (rows_with_missing / total_rows * 100).round(2)

    missing_summary = pd.DataFrame({
        'Missing Count': missing_by_col,
        'Missing Rate (%)': missing_ratio_by_col,
        'Data Type': df.dtypes
    }).sort_values('Missing Rate (%)', ascending=False)

    print(f"Data size: {total_rows} rows × {total_cols} columns")
    print(f"Rows with missing values: {rows_with_missing} ({missing_ratio_by_row}%)")
    print(f"Columns with missing values: {(missing_by_col > 0).sum()}")
    print("\nTop 10 columns with highest missing rates:")
    print(missing_summary.head(10))

    return missing_summary, rows_with_missing, missing_ratio_by_row

def smart_missing_value_processing(df, target_col=None, row_threshold=15, col_threshold=50):
    """Intelligent missing value handling with strategy decision"""
    missing_summary, rows_with_missing, missing_ratio_by_row = analyze_missing_pattern(df, target_col)

    print(f"\n--- Processing Strategy (Row threshold: {row_threshold}%, Column threshold: {col_threshold}%) ---")
    cols_to_drop = missing_summary[missing_summary['Missing Rate (%)'] > col_threshold].index.tolist()
    if target_col and target_col in cols_to_drop:
        cols_to_drop.remove(target_col)

    drop_rows = missing_ratio_by_row <= row_threshold

    print(f"Column strategy: Remove {len(cols_to_drop)} columns (missing rate > {col_threshold}%)")
    if cols_to_drop:
        print(f"  Columns to remove: {cols_to_drop}")

    if drop_rows:
        print(f"Row strategy: Remove rows with missing values (affects {missing_ratio_by_row}% of data – acceptable)")
    else:
        print(f"Row strategy: Impute values (deleting rows would lose {missing_ratio_by_row}% – too much loss)")

    print("\n--- Executing Missing Value Handling ---")
    df_processed = df.copy()

    if cols_to_drop:
        print(f"Removing {len(cols_to_drop)} high-missing columns...")
        df_processed = df_processed.drop(columns=cols_to_drop)
        print(f"Columns after removal: {df_processed.shape[1]}")

    if drop_rows:
        before = df_processed.shape[0]
        df_processed = df_processed.dropna()
        after = df_processed.shape[0]
        print(f"Removed rows with missing values: {before} → {after} (reduced by {before - after})")
    else:
        print("Imputing remaining missing values...")
        fill_report = []
        for col in df_processed.columns:
            if df_processed[col].isnull().sum() > 0:
                if df_processed[col].dtype in ['int64', 'float64', 'int32', 'float32']:
                    fill_value = df_processed[col].median()
                    df_processed[col].fillna(fill_value, inplace=True)
                    fill_report.append([col, 'Numeric', f'Median: {fill_value:.2f}'])
                else:
                    mode_val = df_processed[col].mode()
                    if not mode_val.empty:
                        fill_value = mode_val[0]
                        df_processed[col].fillna(fill_value, inplace=True)
                        fill_report.append([col, 'Categorical', f'Mode: {fill_value}'])
                    else:
                        df_processed[col].fillna('Unknown', inplace=True)
                        fill_report.append([col, 'Categorical', 'Default: Unknown'])

        if fill_report:
            fill_df = pd.DataFrame(fill_report, columns=['Feature', 'Type', 'Imputation Method'])
            print(f"Imputed missing values for {len(fill_report)} features:")
            print(fill_df.head(10))
            report_path = "/content/drive/My Drive/2 auto results/Missing_Value_Imputation_Report.xlsx"
            fill_df.to_excel(report_path, index=False)
            print(f"Imputation report saved to: {report_path}")

    final_missing = df_processed.isnull().sum().sum()
    print(f"\nTotal missing values after processing: {final_missing}")
    print(f"Final data size: {df_processed.shape}")
    return df_processed, cols_to_drop

# Execute Step 3
