def detect_and_handle_outliers(df, target_col=None):
    """Outlier detection with business rules and detailed reporting"""
    df_processed = df.copy()
    num_cols = df_processed.select_dtypes(include=[np.number]).columns.tolist()
    if target_col and target_col in num_cols:
        num_cols = [col for col in num_cols if col != target_col]

    outlier_report = []
    all_outliers_details = []
    non_negative_cols = ["length_of_residence"]
    for col in num_cols:
        lower_col = col.lower()
        if any(k in lower_col for k in ["income", "salary", "tenure", "days", "amount", "amt", "premium", "claim"]):
            if col not in non_negative_cols:
                non_negative_cols.append(col)

    # Check for negative values in non-negative columns
    print("\n=== Checking Negative Values in Non-Negative Columns (Before Fix) ===")
    negative_values_details = []
    for col in non_negative_cols:
        if col in df_processed.columns:
            neg_mask = df_processed[col] < 0
            neg_count = neg_mask.sum()
            if neg_count > 0:
                print(f"Feature {col}: Found {neg_count} negative values (will be removed)")
                neg_data = df_processed[neg_mask].copy()
                neg_data['Outlier Feature'] = col
                neg_data['Outlier Type'] = 'Negative Value'
                neg_data['Outlier Value'] = neg_data[col]
                negative_values_details.append(neg_data)
            else:
                print(f"Feature {col}: No negative values")

    # IQR-based outlier detection
    print("\nDetecting outliers using IQR method...")
    skipped_binary = []
    for col in num_cols:
        unique_vals = df_processed[col].dropna().unique()
        if len(unique_vals) <= 2:
            skipped_binary.append(col)
            print(f"  Skipping binary feature: {col} (values: {sorted(unique_vals)})")
            continue

        Q1 = df_processed[col].quantile(0.25)
        Q3 = df_processed[col].quantile(0.75)
        IQR = Q3 - Q1
        if IQR <= 0:
            continue

        lower_bound = Q1 - 1.5 * IQR
        upper_bound = Q3 + 1.5 * IQR

        # Business protection rules
        if col in non_negative_cols:
            lower_bound = max(lower_bound, 0)
        elif 'age' in col.lower():
            lower_bound = max(lower_bound, 18)
            upper_bound = min(upper_bound, 100)
        elif any(k in col.lower() for k in ['ratio', 'rate']):
            lower_bound = max(lower_bound, 0)
            if upper_bound <= 1.5:
                upper_bound = min(upper_bound, 1)

        outliers_mask = (df_processed[col] < lower_bound) | (df_processed[col] > upper_bound)
        outlier_count = outliers_mask.sum()
        if outlier_count > 0:
            outlier_data = df_processed[outliers_mask].copy()
            outlier_data['Outlier Feature'] = col
            outlier_data['Outlier Type'] = outlier_data[col].apply(lambda x: 'Below Lower Bound' if x < lower_bound else 'Above Upper Bound')
            outlier_data['Outlier Value'] = outlier_data[col]
            outlier_data['Lower Bound'] = lower_bound
            outlier_data['Upper Bound'] = upper_bound
            all_outliers_details.append(outlier_data)

        # Winsorize (cap outliers)
        df_processed[col] = np.where(df_processed[col] < lower_bound, lower_bound, df_processed[col])
        df_processed[col] = np.where(df_processed[col] > upper_bound, upper_bound, df_processed[col])

        outlier_ratio = outlier_count / len(df_processed) * 100
        outlier_report.append([col, outlier_count, round(outlier_ratio, 2), round(lower_bound, 2), round(upper_bound, 2)])

    if skipped_binary:
        print(f"\nSkipped {len(skipped_binary)} binary/categorical features")

    # Remove negative values
    total_removed = 0
    for col in non_negative_cols:
        if col in df_processed.columns:
            before = df_processed.shape[0]
            df_processed = df_processed[df_processed[col] >= 0]
            removed = before - df_processed.shape[0]
            total_removed += removed
            if removed > 0:
                print(f"Feature {col}: Removed {removed} rows with negative values")

    # Save outlier summary
    if outlier_report:
        outlier_summary = pd.DataFrame(outlier_report, columns=["Feature", "Outlier Count", "Outlier %", "Lower Bound", "Upper Bound"])
        outlier_summary_sorted = outlier_summary.sort_values(by="Outlier %", ascending=False)
        print("\n=== IQR Outlier Detection Results (sorted by %) ===")
        print(outlier_summary_sorted)
        output_path = "/content/drive/My Drive/2 auto results/Outlier_Detection_Report_Enhanced.xlsx"
        outlier_summary_sorted.to_excel(output_path, index=False)
        print(f"\nOutlier report saved to: {output_path}")

    # Save detailed outlier records
    if all_outliers_details:
        all_outliers_df = pd.concat(all_outliers_details, ignore_index=True)
        detail_path = "/content/drive/My Drive/2 auto results/IQR_Outlier_Details.xlsx"
        with pd.ExcelWriter(detail_path, engine='openpyxl') as writer:
            all_outliers_df.to_excel(writer, sheet_name='Outlier Details', index=False)
            all_outliers_df.groupby(['Outlier Feature', 'Outlier Type']).size().reset_index(name='Count').to_excel(writer, sheet_name='Summary by Feature', index=False)
        print(f"IQR outlier details saved to: {detail_path} ({len(all_outliers_df)} records)")

    if negative_values_details:
        neg_df = pd.concat(negative_values_details, ignore_index=True)
        neg_path = "/content/drive/My Drive/2 auto results/Negative_Value_Details.xlsx"
        with pd.ExcelWriter(neg_path, engine='openpyxl') as writer:
            neg_df.to_excel(writer, sheet_name='Negative Values', index=False)
            neg_df.groupby('Outlier Feature').size().reset_index(name='Count').to_excel(writer, sheet_name='Summary', index=False)
        print(f"Negative value details saved to: {neg_path} ({len(neg_df)} records)")

    print(f"\nBusiness rules removed {total_removed} rows due to negative values")
    print(f"Data size after processing: {df_processed.shape}")

    # Final quality check
    print("\n=== Final Data Quality Check ===")
    final_neg = sum((df_processed[col] < 0).sum() for col in non_negative_cols if col in df_processed.columns)
    if final_neg == 0:
        print("All non-negative features are now valid")
    final_missing = df_processed.isnull().sum().sum()
    if final_missing == 0:
        print("No missing values remain")
    return df_processed, outlier_report

