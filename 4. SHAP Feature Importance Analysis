# 6. Individual Customer Explanations (FIXED)
# =============================
print("\n" + "="*70)
print("Individual Customer Explanations")
print("="*70)

# y_test 对应整个 X_test，需要重置索引以便用整数位置访问
y_test_reset = y_test.reset_index(drop=True)

quartile_positions = [0, len(sample_indices)//4, len(sample_indices)//2, 3*len(sample_indices)//4]

for i, pos in enumerate(quartile_positions):
    if pos >= len(sample_indices):
        continue

    # pos 是在 test_sample_df 里的行位置（0~499）
    customer_data_series = test_sample_df.iloc[pos]   # DataFrame 行，保留列名
    customer_data_array  = customer_data_series.values.reshape(1, -1)

    # 对应原始 X_test 中的整数位置
    original_pos = sample_indices[pos]
    true_label   = "Churned" if y_test_reset.iloc[original_pos] == 1 else "Retained"

    # ---- 关键修复：用 DataFrame 传入，保留列名 ----
    customer_df = pd.DataFrame(customer_data_array, columns=feature_names_for_shap)
    pred_proba  = best_model.predict_proba(customer_df)[0, 1]
    pred_label  = "High Risk" if pred_proba > 0.5 else "Low Risk"

    print(f"\n Customer {i+1} (Sample position: {pos}, Original test index: {original_pos})")
    print(f"   Actual: {true_label} | Predicted: {pred_label} (Prob: {pred_proba:.3f})")

    try:
        plt.figure(figsize=(12, 8))
        explanation = shap.Explanation(
            values=shap_values_positive[pos],
            base_values=base_value,
            data=customer_data_series.values,
            feature_names=feature_names_for_shap
        )
        shap.waterfall_plot(explanation, max_display=15, show=False)
        plt.title(
            f"Customer {i+1} – {true_label} | Risk: {pred_label} ({pred_proba:.2f})",
            fontsize=14, fontweight='bold'
        )
        plt.tight_layout()
        plt.savefig(f"{output_dir}/shap_waterfall_customer_{i+1}.png", dpi=300, bbox_inches='tight')
        plt.show()
        print(f"   ✓ Saved: shap_waterfall_customer_{i+1}.png")
    except Exception as e:
        print(f"     Waterfall failed: {e}")
        import traceback; traceback.print_exc()

