# =============================
# 3. SHAP Values Computation
# =============================
print("\n" + "="*70)
print("Computing SHAP Values")
print("="*70)

try:
    background_size = min(200, len(X_train_processed))
    background_df = X_train_processed.sample(n=background_size, random_state=42)

    explainer = shap.TreeExplainer(best_model, background_df)
    print(f"✓ TreeExplainer initialized (background: {background_df.shape})")

    test_sample_size = min(500, len(X_test_processed))
    sample_idx_positions = np.random.RandomState(42).choice(
        len(X_test_processed), test_sample_size, replace=False
    )
    # sample_indices 是 X_test 中的整数位置
    sample_indices = sample_idx_positions

    test_sample_df = X_test_processed.iloc[sample_idx_positions].reset_index(drop=True)
    test_sample_array = test_sample_df.values

    print(f"✓ Test sample: {test_sample_df.shape}")

    shap_values = explainer.shap_values(test_sample_df)

    # XGBoost 输出格式处理
    if isinstance(shap_values, list) and len(shap_values) == 2:
        shap_values_positive = shap_values[1]
        print("  ✓ List format → extracted class-1 SHAP values")
    elif isinstance(shap_values, np.ndarray) and shap_values.ndim == 3:
        shap_values_positive = shap_values[:, :, 1]
        print("  ✓ 3D array → extracted class-1 SHAP values")
    else:
        shap_values_positive = shap_values
        print(f"  ✓ Using SHAP values directly: {shap_values_positive.shape}")

    # Base value
    ev = explainer.expected_value
    if isinstance(ev, (list, np.ndarray)):
        base_value = float(ev[1]) if len(ev) > 1 else float(ev[0])
    else:
        base_value = float(ev)

    print(f"✓ SHAP computation complete: {shap_values_positive.shape}")
    print(f"  Base value: {base_value:.4f}")

except Exception as e:
    print(f"✗ SHAP computation failed: {e}")
    import traceback; traceback.print_exc()
    raise

