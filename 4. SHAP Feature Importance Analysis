# 7. Feature Group Analysis
# =============================
print("\n" + "="*70)
print("Feature Group Analysis")
print("="*70)

feature_groups = {
    'Customer Profile':   ['age', 'income', 'children', 'marital', 'education', 'college', 'credit', 'occupation'],
    'Policy & Finance':   ['curr_ann_amt', 'premium', 'coverage', 'deductible', 'good_credit'],
    'Property & Home':    ['home', 'residence', 'market_value', 'property'],
    'Tenure & Time':      ['tenure', 'days', 'cust_orig', 'duration', 'month', 'year'],
}

group_importance = {}
for group_name, keywords in feature_groups.items():
    matched = [f for f in feature_importance['Feature']
               if any(k.lower() in f.lower() for k in keywords)]
    if matched:
        score = feature_importance[feature_importance['Feature'].isin(matched)]['SHAP_Importance'].sum()
        count = len(matched)
        group_importance[group_name] = {
            'score': score, 'count': count,
            'avg': score / count if count > 0 else 0,
            'features': matched
        }

sorted_groups = sorted(group_importance.items(), key=lambda x: x[1]['score'], reverse=True)

print("\nGroup Importance Ranking:")
print("-" * 70)
for rank, (name, info) in enumerate(sorted_groups, 1):
    print(f"{rank}. {name:<22} | Total: {info['score']:.4f} | "
          f"Count: {info['count']:2d} | Avg: {info['avg']:.4f}")
    top3 = feature_importance[feature_importance['Feature'].isin(info['features'])].head(3)
    for _, row in top3.iterrows():
        print(f"   └ {row['Feature']:<40} {row['SHAP_Importance']:.6f}")

group_summary = pd.DataFrame([
    {'Group': name, 'Total': info['score'], 'Count': info['count'], 'Avg': info['avg']}
    for name, info in sorted_groups
])
group_summary.to_csv(f"{output_dir}/shap_group_importance.csv", index=False)
