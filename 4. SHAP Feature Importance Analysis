print("Global Feature Importance")
print("="*70)

shap_mean_abs = np.mean(np.abs(shap_values_positive), axis=0)

if len(feature_names_for_shap) != len(shap_mean_abs):
    print(f"  Mismatch: {len(feature_names_for_shap)} names vs {len(shap_mean_abs)} values → using generic names")
    feature_names_for_shap = [f'feature_{i}' for i in range(len(shap_mean_abs))]
    test_sample_df = pd.DataFrame(test_sample_array, columns=feature_names_for_shap)

feature_importance = pd.DataFrame({
    'Feature': feature_names_for_shap,
    'SHAP_Importance': shap_mean_abs
}).sort_values('SHAP_Importance', ascending=False).reset_index(drop=True)

