# 2. Preprocessing (match training pipeline)
# =============================
print("\n" + "="*70)
print("Preprocessing data to match training pipeline")
print("="*70)

# 你的数据集有以下特征类型（根据你提供的信息）：
# 数值: curr_ann_amt, days_tenure, age_in_years, income, has_children,
#       length_of_residence, home_owner, college_degree, good_credit (9列)
# 分类: cust_orig_date(日期), marital_status, home_market_value (3列)
# 预处理后共15个特征

try:
    label_encoders = joblib.load(f"{save_dir}/label_encoders.pkl")
    print(f"✓ Label encoders loaded: {list(label_encoders.keys())}")
except FileNotFoundError:
    label_encoders = {}
    print("  Label encoders not found, will use raw data")

def preprocess_features(X_df, label_encoders, fit=False):
    """
    复现训练时的预处理流程，输出15个特征的DataFrame
    """
    X = X_df.copy()

    # --- 日期特征处理 ---
    if 'cust_orig_date' in X.columns:
        try:
            X['cust_orig_date'] = pd.to_datetime(X['cust_orig_date'], errors='coerce')
            ref_date = pd.Timestamp('2026-01-01')
            X['cust_tenure_days'] = (ref_date - X['cust_orig_date']).dt.days.fillna(0).astype(int)
            X = X.drop(columns=['cust_orig_date'])
            print("  ✓ cust_orig_date → cust_tenure_days")
        except Exception as e:
            print(f"  Date processing failed: {e}")
            X = X.drop(columns=['cust_orig_date'], errors='ignore')

    # --- home_market_value 有序编码 ---
    if 'home_market_value' in X.columns:
        if 'home_market_value' in label_encoders:
            le = label_encoders['home_market_value']
            X['home_market_value'] = X['home_market_value'].map(
                lambda v: le.transform([v])[0] if v in le.classes_ else -1
            )
        else:
            # 备用：提取范围下界
            def parse_range(val):
                if pd.isna(val): return 0
                try:
                    return int(str(val).split(' - ')[0].replace(',', '').strip())
                except:
                    return 0
            X['home_market_value'] = X['home_market_value'].apply(parse_range)
        print("  ✓ home_market_value encoded")

    # --- marital_status 编码 ---
    if 'marital_status' in X.columns:
        if 'marital_status' in label_encoders:
            le = label_encoders['marital_status']
            X['marital_status'] = X['marital_status'].map(
                lambda v: le.transform([v])[0] if v in le.classes_ else -1
            )
        else:
            X['marital_status'] = pd.Categorical(X['marital_status']).codes
        print("  ✓ marital_status encoded")

    # --- 缺失值填充 ---
    X = X.fillna(0)

    return X

# 预处理训练集和测试集
X_train_processed = preprocess_features(X_train, label_encoders)
X_test_processed  = preprocess_features(X_test,  label_encoders)

